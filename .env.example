# Copy this file to .env and fill in real values -- .env itself should
# never be committed to version control.

# Required: host directories bind-mounted into the container instead
# of using Docker-managed volumes. INKWELL_APP_DIR should contain
# index.html and Python_HTTPS_Server.py -- typically this same folder,
# so editing those files on the host takes effect without rebuilding
# the image (index.html immediately; Python_HTTPS_Server.py after a
# `docker compose restart inkwell`). INKWELL_DATA_DIR is created
# automatically on first run if it doesn't already exist.
INKWELL_APP_DIR=/home/user/docker/inkwell
INKWELL_DATA_DIR=/home/user/docker/inkwell/data

# Only needed for docker-compose.cloudflare.yml -- the token from a
# Cloudflare Zero Trust tunnel (Networks -> Tunnels -> create one,
# choose Docker). Not used by the default docker-compose.yml (Caddy).
CLOUDFLARE_TUNNEL_TOKEN=

# Required: lets you recover a forgotten account password without
# email/SMTP. Use a long, random value -- this can reset *any*
# account's password. Generate one with, e.g.:
#   openssl rand -base64 32
INKWELL_ADMIN_PASSWORD=

# Optional: encrypts hidden notes at rest (see README.md's Security
# section for exactly what this does and doesn't protect against).
# Leave blank to store everything as plain text on disk, same as
# without this feature. If you set it, generate a real random value
# and keep it somewhere safe -- losing it makes any already-encrypted
# hidden notes unrecoverable:
#   openssl rand -base64 32
INKWELL_ENCRYPTION_KEY=

# Optional: speech-to-text (used by clients where typing is awkward,
# e.g. a VR editor -- see README.md's Speech-to-text section). Leave
# blank/unset to disable POST /api/transcribe entirely.
#   local  -- runs on this same server via faster-whisper. Needs the
#             image built with --build-arg INSTALL_STT=1 (see
#             Dockerfile), and INKWELL_STT_LOCAL_MODEL below.
#             No API key, no data ever leaves your server.
#   openai -- OpenAI's transcription API. Needs INKWELL_STT_API_KEY.
#   groq   -- Groq's hosted Whisper (OpenAI-compatible, notably cheap
#             and fast). Needs INKWELL_STT_API_KEY.
#   google -- Google Cloud Speech-to-Text. Needs INKWELL_STT_API_KEY.
#   custom -- your own OpenAI-API-shaped Whisper server, e.g. one
#             running on a separate PC on your network
#             (faster-whisper-server/Speaches, whisper-asr-webservice,
#             etc.). Needs INKWELL_STT_URL; INKWELL_STT_API_KEY only if
#             that server requires auth (many self-hosted ones don't).
INKWELL_STT_PROVIDER=

# Only used when INKWELL_STT_PROVIDER=local. faster-whisper model size
# -- tiny/base/small/medium/large-v3, trading accuracy for speed and
# download size (roughly 75MB to 3GB). "base" is a reasonable default
# on a CPU-only server; go smaller if transcription feels slow.
INKWELL_STT_LOCAL_MODEL=base

# Required for openai/groq/google; optional for custom (only if your
# server needs it); unused for local. Never distributed to any client
# -- every transcription request goes through this server first, so
# the key only ever needs to live here.
INKWELL_STT_API_KEY=

# Only used when INKWELL_STT_PROVIDER=custom -- base URL of your own
# Whisper server, including scheme and any path prefix it uses. This
# server appends "/audio/transcriptions" to it, matching the OpenAI
# API shape most self-hosted Whisper servers implement.
#   INKWELL_STT_URL=http://192.168.1.50:8000/v1
INKWELL_STT_URL=

# Only used when INKWELL_STT_PROVIDER=custom -- sent as the "model"
# field in the request. Most self-hosted servers ignore this value,
# but some care, so it's configurable rather than hardcoded.
INKWELL_STT_MODEL_NAME=whisper-1
